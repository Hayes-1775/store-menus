#!/usr/bin/env python3
import json
import sys
from pathlib import Path

from PIL import Image


def fail(message: str) -> None:
    print(f"FAIL: {message}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    menu_path = Path("data/flower_menu.json")
    validation_path = Path("data/validation_report.json")
    image_path = Path("docs/latest.jpg")
    docs_data_path = Path("docs/menu-data.json")
    html_path = Path("docs/index.html")
    descriptors_path = Path("config/flower_product_descriptors.json")
    aliases_path = Path("config/flower_display_aliases.json")
    vape_image_path = Path("docs/vapes/latest.jpg")
    vape_docs_data_path = Path("docs/vapes/menu-data.json")
    vape_html_path = Path("docs/vapes/index.html")
    vape_page2_image_path = Path("docs/vapes/page2/latest.jpg")
    vape_page2_docs_data_path = Path("docs/vapes/page2/menu-data.json")
    vape_page2_html_path = Path("docs/vapes/page2/index.html")

    if not menu_path.exists():
        fail("missing data/flower_menu.json")
    if not validation_path.exists():
        fail("missing data/validation_report.json")
    if not image_path.exists():
        fail("missing docs/latest.jpg")
    if not docs_data_path.exists():
        fail("missing docs/menu-data.json")
    if not html_path.exists():
        fail("missing docs/index.html")
    if not descriptors_path.exists():
        fail("missing config/flower_product_descriptors.json")
    if not aliases_path.exists():
        fail("missing config/flower_display_aliases.json")
    for path in [
        vape_image_path,
        vape_docs_data_path,
        vape_html_path,
        vape_page2_image_path,
        vape_page2_docs_data_path,
        vape_page2_html_path,
    ]:
        if not path.exists():
            fail(f"missing {path}")

    menu = json.loads(menu_path.read_text(encoding="utf-8"))
    docs_menu = json.loads(docs_data_path.read_text(encoding="utf-8"))
    validation = json.loads(validation_path.read_text(encoding="utf-8"))
    vape_docs_menu = json.loads(vape_docs_data_path.read_text(encoding="utf-8"))
    vape_page2_docs_menu = json.loads(vape_page2_docs_data_path.read_text(encoding="utf-8"))
    descriptors = json.loads(descriptors_path.read_text(encoding="utf-8"))
    aliases = json.loads(aliases_path.read_text(encoding="utf-8"))
    rows = menu.get("rows", [])

    if docs_menu != menu:
        fail("docs/menu-data.json does not exactly match data/flower_menu.json")

    name_counts = {}
    for row in rows:
        name = row["product_name"]
        name_counts[name] = name_counts.get(name, 0) + 1
    duplicate_names = sorted(name for name, count in name_counts.items() if count > 1)
    if duplicate_names:
        fail(f"duplicate product names were not consolidated: {', '.join(duplicate_names)}")
    if len(rows) < 20:
        fail(f"unexpectedly low menu row count: {len(rows)}")
    if len(vape_docs_menu.get("rows", [])) < 20:
        fail(f"unexpectedly low vape menu row count: {len(vape_docs_menu.get('rows', []))}")
    if len(vape_page2_docs_menu.get("rows", [])) < 5:
        fail(f"unexpectedly low vape page 2 row count: {len(vape_page2_docs_menu.get('rows', []))}")

    if not isinstance(descriptors, dict):
        fail("config/flower_product_descriptors.json must contain an object")
    if not isinstance(aliases, dict):
        fail("config/flower_display_aliases.json must contain an object")

    valid_looking_for = {"Sleepy", "Energy", "Hungry", "Chill"}
    missing_descriptors = [row["product_name"] for row in rows if row["product_name"] not in descriptors]
    if missing_descriptors:
        fail(f"missing curated descriptors for: {', '.join(missing_descriptors)}")
    invalid_descriptors = [
        name
        for name, descriptor in descriptors.items()
        if not isinstance(descriptor, dict)
        or not str(descriptor.get("feeling", "")).strip()
        or descriptor.get("looking_for") not in valid_looking_for
    ]
    if invalid_descriptors:
        fail(f"invalid curated descriptors for: {', '.join(invalid_descriptors)}")

    invalid_aliases = [
        name for name, alias in aliases.items()
        if name not in descriptors or not isinstance(alias, str) or not alias.strip()
    ]
    if invalid_aliases:
        fail(f"invalid curated display aliases for: {', '.join(invalid_aliases)}")

    curation_mismatches = []
    for row in rows:
        name = row["product_name"]
        descriptor = descriptors[name]
        expected = {
            "feeling": descriptor["feeling"],
            "looking_for": descriptor["looking_for"],
            "display_name": aliases.get(name, name),
        }
        actual = {key: row.get(key) for key in expected}
        if actual != expected:
            curation_mismatches.append(name)
    if curation_mismatches:
        fail(f"generated menu rows do not match curated maps for: {', '.join(curation_mismatches)}")

    sativa_sleepy_or_chill = [
        row["product_name"]
        for row in rows
        if row.get("strain") == "Sativa" and descriptors[row["product_name"]]["looking_for"] in {"Sleepy", "Chill"}
    ]
    if sativa_sleepy_or_chill:
        fail(f"Sativa curated descriptors cannot use Sleepy/Chill: {', '.join(sativa_sleepy_or_chill)}")

    html = html_path.read_text(encoding="utf-8")
    if "const productDescriptors" in html or "const productDisplayNames" in html:
        fail("docs/index.html still contains hard-coded product curation maps")
    for required_reference in ("row.feeling", "row.looking_for", "row.display_name"):
        if required_reference not in html:
            fail(f"docs/index.html is missing generated curation reference: {required_reference}")

    low_stock_rows = [row for row in rows if row.get("quantity", 0) < 27]
    for row in low_stock_rows:
        if not row.get("closeout"):
            fail(f"{row['product_name']} is missing closeout with quantity {row['quantity']}")
    for row in rows:
        if row.get("quantity", 0) >= 27 and row.get("closeout"):
            fail(f"{row['product_name']} is marked closeout with quantity {row['quantity']}")

    img = Image.open(image_path)
    if img.size != (1080, 1920):
        fail(f"expected 1080x1920 image, got {img.size}")
    vape_img = Image.open(vape_image_path)
    if vape_img.size != (1080, 1920):
        fail(f"expected 1080x1920 vape image, got {vape_img.size}")
    vape_page2_img = Image.open(vape_page2_image_path)
    if vape_page2_img.size != (1080, 1920):
        fail(f"expected 1080x1920 vape page 2 image, got {vape_page2_img.size}")

    print(json.dumps({
        "status": "ok",
        "rows": len(rows),
        "vape_rows": len(vape_docs_menu.get("rows", [])),
        "vape_page2_rows": len(vape_page2_docs_menu.get("rows", [])),
        "missing_price_profiles": len(validation.get("missing_price_profiles", [])),
        "image": str(image_path),
        "html": str(html_path),
        "docs_data": str(docs_data_path),
        "size": img.size,
    }, indent=2))


if __name__ == "__main__":
    main()
