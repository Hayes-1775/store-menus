#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


VALID_LOOKING_FOR = {"Chill", "Energy", "Hungry", "Sleepy"}


def load_object(path: Path, label: str) -> dict:
    payload = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise ValueError(f"{label} must be a JSON object: {path}")
    return payload


def main() -> None:
    parser = argparse.ArgumentParser(description="Merge curated flower descriptors and display aliases into generated menu rows.")
    parser.add_argument("--menu-json", default="data/flower_menu.json")
    parser.add_argument("--descriptors", default="config/flower_product_descriptors.json")
    parser.add_argument("--aliases", default="config/flower_display_aliases.json")
    args = parser.parse_args()

    menu_path = Path(args.menu_json)
    menu = json.loads(menu_path.read_text(encoding="utf-8"))
    descriptors = load_object(Path(args.descriptors), "descriptor map")
    aliases = load_object(Path(args.aliases), "display alias map")
    rows = menu.get("rows", [])

    missing = [row["product_name"] for row in rows if row["product_name"] not in descriptors]
    if missing:
        raise ValueError(f"Missing curated descriptors for: {', '.join(missing)}")

    for row in rows:
        name = row["product_name"]
        descriptor = descriptors[name]
        if not isinstance(descriptor, dict):
            raise ValueError(f"Descriptor for {name} must be an object")
        feeling = str(descriptor.get("feeling", "")).strip()
        looking_for = str(descriptor.get("looking_for", "")).strip()
        if not feeling:
            raise ValueError(f"Descriptor for {name} is missing feeling")
        if looking_for not in VALID_LOOKING_FOR:
            raise ValueError(f"Descriptor for {name} has invalid looking_for: {looking_for}")
        if row.get("strain") == "Sativa" and looking_for in {"Chill", "Sleepy"}:
            raise ValueError(f"Sativa descriptor cannot use {looking_for}: {name}")

        display_name = str(aliases.get(name, name)).strip()
        if not display_name:
            raise ValueError(f"Display alias for {name} is blank")
        row["feeling"] = feeling
        row["looking_for"] = looking_for
        row["display_name"] = display_name

    menu_path.write_text(json.dumps(menu, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps({
        "rows": len(rows),
        "descriptors_applied": len(rows),
        "display_aliases_applied": sum(row["display_name"] != row["product_name"] for row in rows),
        "menu_json": str(menu_path),
    }, indent=2))


if __name__ == "__main__":
    main()
