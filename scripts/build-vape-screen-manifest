#!/usr/bin/env python3
"""Build the static screen manifest consumed by the live cartridge menu."""

import argparse
import json
from pathlib import Path
from typing import Any, Dict, List


def main() -> None:
    parser = argparse.ArgumentParser(description="Build the cartridge screen rotation manifest.")
    parser.add_argument("--config", default="config/menu_config.json")
    parser.add_argument("--docs-dir", default="docs/vapes")
    args = parser.parse_args()

    config = json.loads(Path(args.config).read_text(encoding="utf-8"))
    vape_config = config.get("vape_menu", {})
    screen_count = int(vape_config.get("screen_count", 1))
    rotation_seconds = int(vape_config.get("rotation_seconds", 20))
    if screen_count < 1:
        raise SystemExit("vape_menu.screen_count must be at least 1")
    if not 5 <= rotation_seconds <= 300:
        raise SystemExit("vape_menu.rotation_seconds must be between 5 and 300")

    docs_dir = Path(args.docs_dir)
    screens: List[Dict[str, Any]] = []
    generated_at = None
    for number in range(1, screen_count + 1):
        relative_dir = Path(".") if number == 1 else Path(f"page{number}")
        data_path = docs_dir / relative_dir / "menu-data.json"
        image_path = docs_dir / relative_dir / "latest.jpg"
        if not data_path.exists() or not image_path.exists():
            raise SystemExit(f"Screen {number} output is missing; regenerate the cartridge menus.")
        payload = json.loads(data_path.read_text(encoding="utf-8"))
        rows = payload.get("rows", [])
        if not rows:
            continue
        generated_at = generated_at or payload.get("generated_at")
        prefix = "" if number == 1 else f"page{number}/"
        screens.append(
            {
                "number": number,
                "brands": payload.get("brands", []),
                "row_count": len(rows),
                "data": f"{prefix}menu-data.json",
                "image": f"{prefix}latest.jpg",
            }
        )

    if not screens:
        raise SystemExit("No configured cartridge screen contains products.")
    manifest = {
        "generated_at": generated_at,
        "rotation_seconds": rotation_seconds,
        "configured_screen_count": screen_count,
        "screens": screens,
    }
    output = docs_dir / "screens.json"
    output.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(manifest, indent=2))


if __name__ == "__main__":
    main()
